---
// Lab: vardekjeden øverst (fem varder, tent for det som er i drift), så hvert prosjekt som et vindu i natten.
import Layout from '../layouts/Layout.astro';
import Labscene from '../components/Labscene.astro';
import Varde from '../components/Varde.astro';
import { projects } from '../data/lab';
import { paths, other, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const nb = lang === 'nb';
const roman = ['I', 'II', 'III', 'IV', 'V'];
---
<Layout lang={lang} title={nb ? 'Lab: prototyper av Kristian Høegh Mysen · Vardark' : 'Lab: prototypes by Kristian Høegh Mysen · Vardark'} description={nb ? 'Prototyper og eksperimenter av Kristian Høegh Mysen: Lomma flomvakt, Singularity Tracker, Council, Geopolitikk og Athena.' : 'Prototypes and experiments by Kristian Høegh Mysen: Lomma flood watch, Singularity Tracker, Council, Geopolitics and Athena.'} alt={paths[other(lang)].lab} overlay>
  <section class="hero">
    <div class="hero__scene"><Labscene lang={lang} /></div>
    <div class="hero__text wrap">
      <h1>Lab</h1>
      <p class="hero__lede">{nb ? 'Fem varder. De som brenner, er i drift. Prototyper jeg bygger for å forstå, ikke for å selge.' : 'Five cairns. The ones that burn are live. Prototypes I build to understand, not to sell.'}</p>
    </div>
  </section>

  <div class="rows wrap">
    {projects.map((p, i) => (
      <article id={`p-${i}`} class:list={['row', { 'row--lit': p.live, 'row--flip': i % 2 }]}>
        <figure class="row__fig">
          <div class="frame">
            {p.img ? <img src={p.img} srcset={`${p.img.replace('.webp', '-720.webp')} 720w, ${p.img} 1280w`} sizes="(min-width: 768px) 44vw, 100vw" width="1280" height="800" alt={nb ? `Skjermbilde av ${p.name}` : `Screenshot of ${p.name}`} loading="lazy" decoding="async" /> : <div class="frame__varde"><Varde id={`v${i}`} seed={5 + i} /></div>}
          </div>
        </figure>
        <div class="row__text">
          <p class="row__status"><span class="row__n">{roman[i]}</span><span class="dot" aria-hidden="true"></span>{p[lang].status}</p>
          <h2 class="row__name">{p.name}</h2>
          <p class="row__what">{p[lang].what}</p>
          <p class="row__story">{p[lang].story}</p>
          {p.href && <a class="row__go" href={p.href}>{nb ? 'Gå til' : 'Open'} {p.name} <span aria-hidden="true">→</span></a>}
        </div>
      </article>
    ))}
  </div>
</Layout>

<style>
  .hero { position: relative; height: clamp(34rem, 175vw, 46rem); overflow: hidden; background: #02040a; }
  .hero__scene { position: absolute; inset: 0; }
  .hero__text { position: absolute; inset: auto 0 0; padding-bottom: 1.5rem; z-index: 1; }
  h1 { font: clamp(4rem, 12vw, 8rem)/0.95 var(--display); letter-spacing: 0.04em; text-transform: uppercase; text-shadow: 0 2px 30px rgba(2, 4, 10, 0.9); }
  .hero__lede { max-width: 30rem; margin-top: 0.75rem; font: 400 clamp(1.1rem, 1.6vw, 1.35rem)/1.4 var(--serif); color: #ece8e0; text-shadow: 0 1px 16px rgba(2, 4, 10, 0.9); }

  .rows { padding-top: 2rem; }
  .row { --ember: #3b4a66; display: grid; gap: 1.5rem; padding: 3rem 0; border-top: 1px solid var(--line); scroll-margin-top: 2rem; }
  .row--lit { --ember: #f0a24b; }
  .frame { position: relative; border: 1px solid rgba(240, 162, 75, 0.25); background: #05080f; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 210, 150, 0.08); }
  .row--lit .frame { border-color: rgba(240, 162, 75, 0.45); box-shadow: 0 0 0 1px rgba(240, 162, 75, 0.08), 0 30px 80px -30px rgba(240, 162, 75, 0.35), inset 0 1px 0 rgba(255, 210, 150, 0.12); }
  .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(240, 162, 75, 0.08), transparent 30%); pointer-events: none; }
  .frame img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top left; }
  .frame__varde { position: relative; aspect-ratio: 16 / 10; background: radial-gradient(60% 50% at 50% 85%, #1a2740, #05080f 70%); }
  .frame__varde :global(.varde) { position: absolute; left: 50%; bottom: 6%; height: 78%; width: auto; transform: translateX(-50%); }
  .row__status { display: flex; align-items: center; gap: 0.6rem; font: 0.8125rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: #8d98ad; }
  .row__n { color: #5b6578; }
  .row--lit .row__status { color: #f5b36a; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--ember); box-shadow: 0 0 10px var(--ember); }
  .row__name { margin-top: 0.75rem; font: clamp(2.5rem, 6vw, 4.5rem)/0.95 var(--display); letter-spacing: 0.03em; text-transform: uppercase; color: transparent; background: linear-gradient(180deg, rgba(240, 162, 75, 0.45), rgba(240, 162, 75, 0.06) 70%), url(/material/basalt.webp) center / 380px; -webkit-background-clip: text; background-clip: text; filter: drop-shadow(0 1px 0 rgba(255, 220, 170, 0.22)) drop-shadow(0 -1px 0 #000); }
  .row:not(.row--lit) .row__name { background-image: linear-gradient(180deg, rgba(140, 150, 170, 0.45), rgba(140, 150, 170, 0.06) 70%), url(/material/basalt.webp); }
  .row__what { margin-top: 1rem; font: 400 1.25rem/1.4 var(--serif); color: #ece8e0; }
  .row__story { margin-top: 0.75rem; color: #b3bccb; max-width: 34rem; }
  .row__go { display: inline-block; margin-top: 1.5rem; font: 0.9375rem/1 var(--mono); color: #ffe2b8; text-decoration: none; border-bottom: 1px solid var(--ember); padding-bottom: 0.3rem; }
  .row__go:hover { color: #fff; }
  @media (min-width: 768px) {
    .hero { height: clamp(34rem, 110vw, 50rem); }
    .hero__text { padding-bottom: 2.5rem; }
    .rows { padding-top: 3rem; }
    .row { grid-template-columns: 7fr 5fr; gap: 3rem; align-items: center; padding: 4rem 0; }
    .row--flip .row__fig { order: 2; }
  }
  @media (min-width: 1024px) { .hero { height: clamp(28rem, 42vw, 44rem); } }
</style>
