---
import Layout from '../layouts/Layout.astro';
import Cairn from '../components/Cairn.astro';
import { paths, other, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const nb = lang === 'nb';
const site = Astro.site!.href;

// Fakta fra Kristians CV (2026). Ingen kontaktinfo, adresse eller fødselsdato. Ingen selskapslenker før selskapet finnes.
const stats = nb
  ? [['15+', 'år med programvare, arkitektur og ledelse'], ['15→150+', 'personer og 18 team i leveranseorganisasjonen jeg bygde'], ['12', 'år med forsvarsteknologi'], ['13', 'år i Heimevernets innsatsstyrke']]
  : [['15+', 'years in software, architecture and leadership'], ['15→150+', 'people and 18 teams in the delivery organisation I built'], ['12', 'years in defence technology'], ['13', 'years in the Home Guard rapid response force']];
const background = nb
  ? [
      'I forsvarssektoren leder jeg arbeid med strategiske prosjekter og styring, og med å omsette strategi til virksomhetsarkitektur.',
      'Jeg har bygget en Lean/Agile-leveranseorganisasjon fra rundt 15 til over 150 personer og 18 team, og hatt ansvar for virkemåter, porteføljestyring og kontinuerlig forbedring i store programmer. Før det ledet jeg innføringen av smidige arbeidsformer og DevSecOps, med arkitektansvar for militær IT-infrastruktur, IT-sikkerhet og sikker kommunikasjon.',
      'I forsvarsindustrien var jeg utvikler og arkitekt i Teleplan Globe på FACNAV/norBMS, digital støtte for luftstøtte, ildstøtte og battlespace management, og prosjektleder og arkitekt for Baseforsvarsdemonstratoren sammen med FFI, som ble vist for over 60 nasjonale og internasjonale beslutningstakere. Før det bygde jeg store statlige systemer i Computas, blant annet Norvis for visum og innreise, og programvare for rørledningsintegritet i DNV.',
      'Militært: Befalsskolen for Kavaleriet, sersjant og vognkommandør på CV90 i Panserbataljonen, og 13 år som lagfører i Heimevernets innsatsstyrke Derby.',
    ]
  : [
      'In the defence sector I lead work on strategic projects and governance, and on turning strategy into enterprise architecture.',
      'I built a Lean/Agile delivery organisation from around 15 to more than 150 people and 18 teams, and have been responsible for ways of working, portfolio management and continuous improvement in large programmes. Before that I led the introduction of agile ways of working and DevSecOps, as architect for military IT infrastructure, IT security and secure communications.',
      'In the defence industry I was a developer and architect at Teleplan Globe on FACNAV/norBMS, digital support for close air support, fire support and battlespace management, and project lead and architect for the Base Defence Demonstrator with the Norwegian Defence Research Establishment (FFI), shown to more than 60 national and international decision-makers. Earlier I built large government systems at Computas, including Norvis for visas and entry to Norway, and pipeline integrity software at DNV.',
      'Military: the Cavalry NCO School, sergeant and vehicle commander on CV90 in the Armoured Battalion, and 13 years as section leader in the Home Guard rapid response force Derby.',
    ];
const creds = nb
  ? [['Sivilingeniør datateknikk (MSc Computer Science)', 'NTNU 2009 · masteroppgave A'], ['Kontinuerlig forbedring og Lean', 'Universitetet i Agder'], ['Topp500', 'Forsvarets digitale lederprogram'], ['SAFe Agilist, POPM og LPM', 'Scaled Agile'], ['MoP Foundation', 'porteføljestyring'], ['Certified Ethical Hacker (CEH)', 'EC-Council'], ['TOGAF', 'kurs, virksomhetsarkitektur'], ['Professional Scrum Master (PSM I)', 'Scrum.org'], ['Linjelederkurs', 'Forsvaret']]
  : [['MSc Computer Science', 'NTNU 2009 · thesis graded A'], ['Continuous Improvement and Lean', 'University of Agder'], ['Topp500', 'Armed Forces digital leadership programme'], ['SAFe Agilist, POPM and LPM', 'Scaled Agile'], ['MoP Foundation', 'portfolio management'], ['Certified Ethical Hacker (CEH)', 'EC-Council'], ['TOGAF', 'course, enterprise architecture'], ['Professional Scrum Master (PSM I)', 'Scrum.org'], ['Line management course', 'Norwegian Armed Forces']];
const fields = nb
  ? ['KI-agenter og frontier-modeller', 'Lokale modeller og åpne vekter', 'Forsvarsteknologi og militære IT-systemer', 'Informasjonssikkerhet', 'Virksomhetsarkitektur', 'Smidig transformasjon i stor skala', 'Teknologi og geopolitikk']
  : ['AI agents and frontier models', 'Local models and open weights', 'Defence technology and military IT systems', 'Information security', 'Enterprise architecture', 'Agile transformation at scale', 'Technology and geopolitics'];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  inLanguage: nb ? 'nb-NO' : 'en',
  mainEntity: {
    '@type': 'Person', '@id': `${site}#kristian`, name: 'Kristian Høegh Mysen',
    jobTitle: nb ? 'Teknologileder' : 'Technology leader',
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'NTNU' },
    hasCredential: ['Certified SAFe Agilist', 'SAFe Product Owner/Product Manager', 'SAFe Lean Portfolio Management', 'MoP Foundation', 'Certified Ethical Hacker (CEH)', 'Professional Scrum Master I'].map((name) => ({ '@type': 'EducationalOccupationalCredential', name })),
    knowsAbout: fields,
    sameAs: ['https://www.linkedin.com/in/kristianmysen'],
  },
};
---
<Layout lang={lang} title={nb ? 'Om Kristian Høegh Mysen · Vardark' : 'About Kristian Høegh Mysen · Vardark'} description={nb ? 'Kristian Høegh Mysen: sivilingeniør i datateknikk med tolv år i forsvarsteknologi, ledelse av strategiske prosjekter og styring. Skriver om KI, sikkerhet og geopolitikk.' : 'Kristian Høegh Mysen: MSc in computer science with twelve years in defence technology, leading strategic projects and governance. Writes on AI, security and geopolitics.'} alt={paths[other(lang)].about} jsonld={jsonld}>
  <div class="about wrap">
    <h1>{nb ? 'Om' : 'About'}</h1>
    <p class="lead">{nb
      ? 'Jeg er Kristian Høegh Mysen, sivilingeniør i datateknikk. I tolv år har jeg jobbet med teknologi i forsvarssektoren, først som utvikler og arkitekt i forsvarsindustrien og de siste årene med ledelse av strategiske prosjekter, styring og arkitektur. Her skriver jeg om hva som skjer når intelligens blir billig: fremskrittene, mulighetene og risikoen.'
      : 'I am Kristian Høegh Mysen, an MSc in computer science. For twelve years I have worked with technology in the defence sector, first as a developer and architect in the defence industry and in recent years leading strategic projects, governance and architecture. Here I write about what happens when intelligence gets cheap: the progress, the opportunities and the risks.'}</p>

    <blockquote class="quote"><p>{nb ? 'Sjelden kombinasjon: dyp teknologi, strategisk ledelse og militær bakgrunn.' : 'A rare combination: deep technology, strategic leadership and a military background.'}</p></blockquote>

    <dl class="stats">
      {stats.map(([n, l]) => <div><dt>{n}</dt><dd>{l}</dd></div>)}
    </dl>

    <section class="block">
      <h2>{nb ? 'Bakgrunn' : 'Background'}</h2>
      {background.map((p) => <p>{p}</p>)}
    </section>

    <section class="block">
      <h2>{nb ? 'Hva jeg gjør nå' : 'What I do now'}</h2>
      <p>{nb
        ? 'Ved siden av jobben bygger jeg selv. Hjemme kjører jeg en egen KI-plattform med agenter og lokale modeller, og prototypene i laben følger tempoet i KI-utviklingen, geopolitikken og hvordan mennesker kan styre agenter. Jeg tester frontier-modellene i praksis før jeg skriver om dem.'
        : 'Alongside my job I build things myself. At home I run my own AI platform with agents and local models, and the prototypes in the lab track the pace of AI, geopolitics and how people can stay in charge of agents. I test the frontier models hands-on before I write about them.'} <a href={paths[lang].lab}>{nb ? 'Se laben' : 'See the lab'}</a>.</p>
      <p class="disclaimer">{nb ? 'Innleggene er mine egne vurderinger og representerer ikke min arbeidsgiver.' : 'The posts are my own views and do not represent my employer.'}</p>
    </section>

    <section class="block">
      <h2>{nb ? 'Fagfelt' : 'Areas'}</h2>
      <ul class="chips">{fields.map((x) => <li>{x}</li>)}</ul>
    </section>

    <section class="block">
      <h2>{nb ? 'Utdanning og kurs' : 'Education and training'}</h2>
      <ul class="creds">
        {creds.map(([n, d]) => <li><span class="creds__mark" aria-hidden="true"><Cairn size={16} /></span><b>{n}</b><span>{d}</span></li>)}
      </ul>
    </section>

    <section class="def" aria-labelledby="varde">
      <h2 id="varde" class="def__hw">varde</h2>
      <p class="def__pos">{nb ? 'substantiv, hankjønn' : 'Norwegian, noun: beacon cairn'}</p>
      <p class="def__body">{nb
        ? 'Stabel av stein på en fjelltopp eller et nes, med tørrved klar på toppen. Ifølge Snorre lot Håkon den gode bygge varder langs hele kysten. Når fienden ble sett, ble den første tent, og lyset gikk fra fjell til fjell til hele landet var varslet.'
        : 'A stack of stones on a mountaintop or headland, with dry wood ready on top. According to Snorri, King Haakon the Good had beacons built along the whole Norwegian coast. When an enemy was sighted, the first was lit, and the light passed from mountain to mountain until the whole country had been warned.'}</p>
      <p class="def__note">{nb ? 'Vardark: varden i mørket. Innleggene her er ment som varsellys.' : 'Vardark: the beacon in the dark. The posts here are meant as warning lights.'}</p>
    </section>

    <section class="block">
      <h2>{nb ? 'Kontakt' : 'Contact'}</h2>
      <p><a href="https://www.linkedin.com/in/kristianmysen" rel="me">LinkedIn</a> · <a href={paths[lang].rss}>RSS</a></p>
    </section>
  </div>
</Layout>

<style>
  .about { max-width: 52rem; padding-top: 3rem; }
  h1 { font: clamp(2.5rem, 7vw, 4.5rem)/1 var(--display); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2rem; }
  .lead { max-width: 40rem; font: 420 clamp(1.3rem, 2.4vw, 1.6rem)/1.45 var(--serif); color: var(--text); }
  .about p { max-width: 37rem; }
  .about a { color: var(--text); text-decoration-color: var(--ember); text-underline-offset: 0.18em; }

  .quote { position: relative; margin: 3rem 0; padding: 1.5rem 0 1.5rem 1.75rem; border-left: 2px solid var(--ember); }
  .quote p { font: italic 400 clamp(1.5rem, 3.2vw, 2.1rem)/1.3 var(--serif); color: #ffe2b8; max-width: 34rem; }

  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1.25rem; margin: 2.5rem 0 1rem; padding: 2rem 0; border-block: 1px solid var(--line); }
  .stats dt { font: clamp(2.4rem, 6vw, 3.4rem)/1 var(--display); color: transparent; background: linear-gradient(180deg, #ffd9a0, var(--ember) 60%, #a8581f); -webkit-background-clip: text; background-clip: text; }
  .stats dd { margin-top: 0.5rem; font: 0.9375rem/1.4 var(--mono); color: #c3cad6; }

  .block { margin-top: 3rem; }
  .block h2 { font: 1.5rem/1 var(--display); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 1rem; }
  .block p { font-size: 1.1875rem; line-height: 1.7; color: #e7e3db; }
  .block p + p { margin-top: 1em; }

  .block .disclaimer { margin-top: 1.25rem; font: italic 1rem/1.5 var(--serif); color: #aab3c2; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .chips li { padding: 0.5rem 0.85rem; border: 1px solid #2a3a58; border-radius: 999px; font: 0.9375rem/1.2 var(--mono); color: #d6dbe4; background: rgba(17, 26, 42, 0.6); }

  .creds { display: grid; gap: 0.25rem; border-top: 1px solid var(--line); }
  .creds li { display: grid; grid-template-columns: 1.5rem 1fr; column-gap: 0.75rem; align-items: baseline; padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
  .creds__mark { grid-row: span 2; color: #8793aa; --ember: #f0a24b; align-self: center; }
  .creds b { font: 450 1.1875rem/1.3 var(--serif); }
  .creds li > span:last-child { font: 0.875rem/1.3 var(--mono); color: #b3bccb; }

  .def { margin: 4rem 0 1rem; padding: 2.5rem 0; border-block: 1px solid var(--line); }
  .def__hw { font: italic 300 clamp(4.5rem, 16vw, 8rem)/0.85 var(--serif); letter-spacing: -0.04em; color: transparent; background: linear-gradient(180deg, #ffd9a0 0%, var(--ember) 45%, #8a4a1c 100%); -webkit-background-clip: text; background-clip: text; filter: drop-shadow(0 0 28px rgba(240, 162, 75, 0.25)); padding-bottom: 0.1em; }
  .def__pos { margin-top: 0.5rem; font: italic 0.95rem/1 var(--serif); color: var(--muted); }
  .def__body { margin-top: 1.5rem; font-size: 1.3rem; line-height: 1.55; color: #cfd3db; }
  .def__note { margin-top: 1rem; font: 0.9375rem/1.5 var(--mono); color: #f5b36a; }

  @media (min-width: 768px) {
    .stats { grid-template-columns: 1fr 1.45fr 1fr 1fr; column-gap: 2rem; }
    .creds li { grid-template-columns: 1.5rem 1fr auto; }
    .creds__mark { grid-row: auto; }
  }
</style>
