---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import Retning from '../../layouts/Retning.astro';
import Cairn from '../../components/Cairn.astro';
import { essays, fmtDate, iso } from '../../lib/essays';
import { projects } from '../../data/lab';

const list = await essays();
const links = [
  { href: '/', label: 'Essays' },
  { href: '/lab/', label: 'Lab' },
  { href: '/om/', label: 'Om' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<Retning title="Steinen · Vardark designrunde 2" bodyClass="stein">
  <header class="top wrap">
    <a href="/" class="top__logo" aria-label="Vardark, til forsiden"><Cairn size={26} /><span>Kristian Høegh Mysen</span></a>
    <nav class="top__nav" aria-label="Hovednavigasjon">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  </header>

  <main id="innhold">
    <section class="mast wrap">
      <h1 class="mast__word">Vardark</h1>
      <div class="mast__row">
        <p class="mast__intro">Essays om frontier-modeller, åpne vekter, sikkerhet og hva som skjer når intelligens blir billig. Skrevet som en saga: i rekkefølge, nummerert, uten algoritme.</p>
        <dl class="mast__facts">
          <div><dt>Essays</dt><dd>{list.length}</dd></div>
          <div><dt>Første</dt><dd>{list.at(-1)!.date.getFullYear()}</dd></div>
          <div><dt>Siste</dt><dd>{fmtDate(list[0].date)}</dd></div>
        </dl>
      </div>
    </section>

    <section class="saga wrap" aria-labelledby="sagaen">
      <h2 id="sagaen" class="saga__h">Sagaen</h2>
      <ol class="saga__list" reversed>
        {list.map((e, i) => (
          <li class="saga__item">
            <span class="saga__n" aria-hidden="true">{String(list.length - i).padStart(2, '0')}</span>
            <div class="saga__body">
              <p class="saga__meta"><time datetime={iso(e.date)}>{fmtDate(e.date)} {e.date.getFullYear()}</time></p>
              <h3 class="saga__title"><a href={`/essays/${e.id}/`}>{e.title}</a></h3>
              <p class="saga__ex"><span class="saga__init">{e.excerpt.charAt(0)}</span>{e.excerpt.slice(1)}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="smia wrap" aria-labelledby="lab">
      <h2 id="lab" class="saga__h">Verkstedet</h2>
      <ul class="smia__list">
        {projects.map((p) => (
          <li>
            <a href={p.href} class="smia__name">{p.name}</a>
            <span class="smia__what">{p.what}</span>
            <span class="smia__status">{p.status}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="foot wrap">
    <span class="foot__word" aria-hidden="true">Vardark</span>
    <p>© 2026 Kristian Høegh Mysen · <a href="/rss.xml">RSS</a> · Selskapet: <a href="https://athenatech.no">athenatech.no</a></p>
  </footer>
</Retning>

<style is:global>
  body.stein {
    --bg: #e4e4df; --text: #0f1c2e; --muted: #4b5565; --line: #c4c6c0; --ember: #b8651c;
    --serif: 'Source Serif 4 Variable', Georgia, serif;
    --display: 'Barlow Condensed', 'Arial Narrow', sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    background: var(--bg) url('/material/basalt.webp') 0 0 / 1000px; color: var(--text); font: 1.1875rem/1.6 var(--serif);
  }
</style>

<style>
  .wrap { width: 100%; max-width: 82rem; margin: 0 auto; padding-inline: 1.25rem; }
  a:focus-visible { outline: 2px solid var(--ember); outline-offset: 4px; }

  .top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem; }
  .top__logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; font: 600 0.9375rem/1 var(--display); letter-spacing: 0.12em; text-transform: uppercase; }
  .top__logo span { display: none; }
  .top__nav { display: flex; gap: 1.1rem; }
  .top__nav a { font: 600 0.9375rem/1 var(--display); letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; }
  .top__nav a:first-child { box-shadow: inset 0 -3px 0 var(--ember); }

  /* Ordet hugget i stein over hele bredden */
  .mast { padding-top: 0.5rem; padding-bottom: 3rem; border-bottom: 3px solid var(--text); }
  .mast__word {
    font: 800 calc((100vw - 2.5rem) / 3.3)/0.78 var(--display); text-transform: uppercase; letter-spacing: -0.01em;
    color: transparent;
    background: url('/material/basalt.webp') 0 0 / 700px, #1b2737;
    background-blend-mode: multiply;
    -webkit-background-clip: text; background-clip: text;
    filter: drop-shadow(0 2px 0 rgba(255, 255, 255, 0.8)) drop-shadow(0 -1px 0 rgba(0, 0, 0, 0.45));
    margin-left: -0.04em; white-space: nowrap;
  }
  .mast__row { display: grid; gap: 2rem; margin-top: 2rem; }
  .mast__intro { font-size: 1.25rem; line-height: 1.5; max-width: 34rem; }
  .mast__facts { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 2rem; }
  .mast__facts dt { font: 0.6875rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .mast__facts dd { font: 800 2.5rem/1 var(--display); text-transform: uppercase; margin-top: 0.35rem; }

  .saga { padding-top: 3rem; padding-bottom: 4rem; }
  .saga__h { font: 800 1rem/1 var(--display); letter-spacing: 0.24em; text-transform: uppercase; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 1rem; }
  .saga__h::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .saga__item { display: grid; grid-template-columns: 3.75rem 1fr; gap: 1rem; padding: 1.75rem 0; border-top: 1px solid var(--line); }
  .saga__n {
    font: 800 3.25rem/0.85 var(--display); color: rgba(15, 28, 46, 0.16);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8), 0 -1px 0 rgba(0, 0, 0, 0.18);
  }
  .saga__meta { font: 0.75rem/1 var(--mono); color: var(--muted); }
  .saga__title { margin-top: 0.6rem; font: 800 clamp(1.9rem, 6vw, 3.25rem)/1.08 var(--display); text-transform: uppercase; letter-spacing: 0.005em; text-wrap: balance; }
  .saga__title a { text-decoration: underline; text-decoration-color: var(--ember); text-decoration-thickness: 0.08em; text-underline-offset: 0.07em; }
  .saga__title a:hover { color: #3a2410; }
  .saga__item:first-child .saga__title { font-size: clamp(2.5rem, 9vw, 5.25rem); line-height: 1.16; }
  .saga__item:first-child .saga__n { color: rgba(184, 101, 28, 0.35); }
  .saga__ex { margin-top: 1rem; max-width: 40rem; font-size: 1.0625rem; color: var(--muted); }
  .saga__init { float: left; font: 800 3.5rem/0.8 var(--display); color: var(--ember); margin: 0.12em 0.12em 0 0; }

  .smia { padding-bottom: 4rem; }
  .smia__list li { display: grid; gap: 0.25rem; padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .smia__name { font: 800 1.75rem/1 var(--display); text-transform: uppercase; text-decoration: underline; text-decoration-color: var(--ember); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .smia__what { font-size: 1rem; color: var(--muted); }
  .smia__status { font: 0.75rem/1 var(--mono); color: var(--muted); text-transform: uppercase; }

  .foot { padding-bottom: 2.5rem; border-top: 3px solid var(--text); }
  .foot__word { display: block; font: 800 calc((100vw - 2.5rem) / 3.3)/0.78 var(--display); text-transform: uppercase; color: transparent; -webkit-text-stroke: 1px rgba(15, 28, 46, 0.25); margin: 1.5rem 0 1.5rem -0.04em; white-space: nowrap; }
  .foot p { font: 0.75rem/1.5 var(--mono); color: var(--muted); }
  .foot a { color: var(--text); text-decoration-color: var(--ember); }

  @media (min-width: 768px) {
    .wrap { padding-inline: 2.5rem; }
    .top__logo span { display: inline; }
    .top__nav { gap: 2rem; }
    .mast__word { font-size: min(calc((100vw - 5rem) / 3.3), 23.3rem); }
    .mast__row { grid-template-columns: 1fr auto; align-items: end; }
    .mast__facts { gap: 3rem; }
    .mast__facts dd { font-size: 3.25rem; }
    .saga__item { grid-template-columns: 8rem 1fr 24rem; column-gap: 3rem; padding: 2.5rem 0; align-items: start; }
    .saga__n { font-size: 6.5rem; grid-row: span 2; }
    .saga__body { display: contents; }
    .saga__meta { grid-column: 2; grid-row: 1; }
    .saga__title { grid-column: 2; grid-row: 2; margin-top: 0.5rem; }
    .saga__ex { grid-column: 3; grid-row: 1 / span 2; margin-top: 0; font-size: 1rem; }
    .smia__list li { grid-template-columns: 18rem 1fr 8rem; column-gap: 2.5rem; align-items: baseline; }
    .smia__status { text-align: right; }
    .foot__word { font-size: min(calc((100vw - 5rem) / 3.3), 23.3rem); }
  }
</style>
