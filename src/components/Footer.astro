---
import Cairn from './Cairn.astro';
import Urnes from './Urnes.astro';
import { paths, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
---
<div class="orn wrap"><Urnes /></div>
<footer class="foot wrap">
  <Cairn size={22} />
  <p>© {new Date().getFullYear()} Kristian Høegh Mysen · <a href={paths[lang].rss}>RSS</a></p>
</footer>
<style>
  .orn { color: var(--ember); opacity: 0.4; --urnes-bg: var(--bg); padding-top: 5rem; }
  .foot { display: flex; align-items: center; gap: 1rem; padding-top: 1rem; padding-bottom: 3rem; color: var(--muted); font: 0.875rem/1.5 var(--mono); }
  .foot a { color: var(--text); text-decoration-color: var(--ember); }
</style>
