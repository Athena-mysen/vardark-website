---
import Layout from '../layouts/Layout.astro';
const projects = [
  { name: 'Singularity Tracker', what: 'Et observatorium for tempoet i KI-utviklingen: modeller, benchmarks og hendelser på én tidslinje.', status: 'i drift', href: 'https://singularity.vardark.no/tracker' },
  { name: 'Council', what: 'Et råd av KI-avatarer med egne personligheter og langtidsminne, ledet av et menneske. Selvhostet.', status: 'prototype', href: 'https://council.vardark.no' },
  { name: 'Geopolitikk', what: 'Radar over geopolitiske hendelser med betydning for teknologi og sikkerhet.', status: 'eksperiment', href: 'https://geopolitics.vardark.no' },
  { name: 'Athena', what: 'Min egen agentplattform, som driver hjemmet, og nå selskapet AthenaTech. Grunnlaget for det meste her.', status: 'i drift', href: 'https://athenatech.no' },
];
---
<Layout title="Lab — Vardark" description="Prototyper og eksperimenter av Kristian Høegh Mysen.">
  <section class="head">
    <h1>Lab</h1>
    <p class="muted">Prototyper. De ser ut som prototyper. Det som blir produkt, flytter til <a href="https://athenatech.no">AthenaTech</a>.</p>
  </section>
  <ul class="lab">
    {projects.map((p) => (
      <li class="lab__row">
        <a href={p.href} class="lab__name">{p.name}</a>
        <span class="lab__what">{p.what}</span>
        <span class="mono">{p.status}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .head { padding: var(--s-8) 0 var(--s-8); }
  .head p { margin-top: var(--s-3); }
  .lab { list-style: none; border-top: 1px solid var(--line); }
  .lab__row { display: grid; gap: var(--s-1); padding: var(--s-4) 0; border-bottom: 1px solid var(--line); max-width: none; }
  .lab__name { font-size: 1.25rem; text-decoration: none; }
  .lab__name:hover { text-decoration: underline; }
  .lab__what { color: var(--muted); font-size: 1rem; }
  @media (min-width: 640px) {
    .lab__row { grid-template-columns: 11rem 1fr 6rem; gap: var(--s-4); align-items: baseline; }
    .lab__row .mono { text-align: right; }
  }
</style>
