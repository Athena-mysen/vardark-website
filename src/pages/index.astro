---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
const essays = (await getCollection('essays')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const byYear = new Map();
for (const e of essays) {
  const y = e.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y).push(e);
}
const fmt = (d) => d.toLocaleDateString('nb-NO', { day: 'numeric', month: 'short' }).replace('.', '');
---
<Layout>
  <section class="intro">
    <p>Jeg er Kristian Høegh Mysen, sivilingeniør med bakgrunn fra forsvarsteknologi. Her skriver jeg om frontier-modeller, åpne vekter, sikkerhet og hva som skjer når intelligens blir billig. Prototypene ligger i <a href="/lab/">laben</a>. Selskapet er <a href="https://athenatech.no">AthenaTech</a>.</p>
  </section>

  {[...byYear.entries()].map(([year, list]) => (
    <section class="year">
      <h2 class="year__h mono">{year}</h2>
      <ol class="chron">
        {list.map((e) => (
          <li class="chron__row">
            <time class="mono" datetime={e.data.date.toISOString().slice(0, 10)}>{fmt(e.data.date)}</time>
            <a href={`/essays/${e.id}/`} class="chron__title">{e.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Layout>

<style>
  .intro { padding: var(--s-8) 0 var(--s-12); }
  .intro p { font-size: 1.25rem; line-height: 1.5; color: var(--muted); max-width: 40ch; }
  .year { padding-top: var(--s-6); }
  .year__h { font-weight: 400; font-size: 0.8125rem; letter-spacing: 0.1em; padding-bottom: var(--s-2); border-bottom: 1px solid var(--line); margin-bottom: var(--s-2); }
  .chron { list-style: none; }
  .chron__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
    max-width: none;
  }
  .chron__title { text-decoration: none; font-size: 1.25rem; line-height: 1.3; }
  .chron__title:hover { text-decoration: underline; }
</style>
