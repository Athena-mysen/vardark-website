---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/fjalla-one/latin.css';
import Retning from '../../layouts/Retning.astro';
import Cairn from '../../components/Cairn.astro';
import { essays, fmtDate, iso } from '../../lib/essays';
import { projects } from '../../data/lab';

const list = await essays();
const years = [...new Set(list.map((e) => e.date.getFullYear()))];
const latest = list[0];
const links = [
  { href: '/', label: 'Essays' },
  { href: '/lab/', label: 'Lab' },
  { href: '/om/', label: 'Om' },
  { href: '/rss.xml', label: 'RSS' },
];
---
<Retning title="Nattsiden · Vardark designrunde 2" bodyClass="natt">
  <header class="mast">
    <a href="/" class="mast__logo" aria-label="Vardark, til forsiden"><Cairn size={30} /><span>VARDARK</span></a>
    <nav class="mast__nav" aria-label="Hovednavigasjon">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  </header>

  <main id="innhold">
    <section class="hero">
      <picture>
        <source media="(min-width: 768px)" srcset="/material/natt-varde.webp" />
        <img src="/material/natt-varde-mobil.webp" alt="En varde på en fjelltopp om natten, med ett ravgult lys på toppen" width="900" height="1500" />
      </picture>
      <div class="hero__text">
        <p class="hero__kicker">Essays og lab · Kristian Høegh Mysen</p>
        <h1 class="hero__title">Varsellys for en tid der intelligens blir billig.</h1>
        <p class="hero__intro">Jeg skriver om frontier-modeller, åpne vekter, sikkerhet og geopolitikk. Lange tekster, skrevet for å leses ferdig.</p>
        <a class="hero__latest" href={`/essays/${latest.id}/`}>
          <span>Siste essay · {fmtDate(latest.date)}</span>
          {latest.title}
        </a>
      </div>
    </section>

    <section class="chron" aria-labelledby="kronike">
      <header class="chron__head wrap">
        <h2 id="kronike">Krønike</h2>
        <p>{list.length} essays, nyeste først</p>
      </header>
      {years.map((y) => (
        <div class="year wrap">
          <p class="year__n" aria-hidden="true">{y}</p>
          <h3 class="sr">{y}</h3>
          <ol class="entries">
            {list.filter((e) => e.date.getFullYear() === y).map((e) => (
              <li class="entry">
                <a href={`/essays/${e.id}/`}>
                  <span class="entry__meta"><time datetime={iso(e.date)}>{fmtDate(e.date)}</time></span>
                  <span class="entry__title">{e.title}</span>
                  <span class="entry__ex">{e.excerpt}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="lab wrap" aria-labelledby="lab">
      <header class="chron__head chron__head--lab">
        <h2 id="lab">Lab</h2>
        <p>Prototyper. De ser ut som prototyper.</p>
      </header>
      <ul class="beacons">
        {projects.map((p) => (
          <li class={`beacon ${p.status === 'i drift' ? 'is-lit' : ''}`}>
            <span class="beacon__dot" aria-hidden="true"></span>
            <a href={p.href} class="beacon__name">{p.name}</a>
            <span class="beacon__what">{p.what}</span>
            <span class="beacon__status">{p.status}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="foot wrap">
    <Cairn size={22} />
    <p>© 2026 Kristian Høegh Mysen · <a href="/rss.xml">RSS</a> · Selskapet: <a href="https://athenatech.no">athenatech.no</a></p>
  </footer>
</Retning>

<style is:global>
  body.natt {
    --bg: #0a101c; --bg-2: #111a2a; --text: #e6e3dc; --muted: #9aa3b2; --line: #1f2b42; --ember: #f0a24b;
    --serif: 'Source Serif 4 Variable', Georgia, serif;
    --display: 'Fjalla One', 'Arial Narrow', sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    background: var(--bg); color: var(--text); font: 1.1875rem/1.6 var(--serif);
    color-scheme: dark;
  }
</style>

<style>
  .wrap { width: 100%; max-width: 76rem; margin: 0 auto; padding-inline: 1.5rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  a:focus-visible { outline: 2px solid var(--ember); outline-offset: 4px; }

  .mast { position: absolute; z-index: 3; inset: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem; }
  .mast__logo { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--text); }
  .mast__logo span { font: 1.375rem/1 var(--display); letter-spacing: 0.22em; padding-top: 3px; }
  .mast__nav { display: flex; gap: 1.1rem; }
  .mast__nav a { font: 0.75rem/1 var(--mono); color: var(--muted); text-decoration: none; }
  .mast__nav a:first-child { color: var(--text); border-bottom: 1px solid var(--ember); padding-bottom: 3px; }

  /* Hero: landskapet bærer siden */
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; background: #060a12; }
  .hero picture, .hero img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero img { object-fit: cover; object-position: 50% 0; }
  .hero__text { position: relative; z-index: 1; width: 100%; max-width: 76rem; margin: 0 auto; padding: 0 1.5rem 3rem; }
  .hero__kicker { font: 0.75rem/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ember); }
  .hero__title { margin-top: 1rem; max-width: 15ch; font: 400 clamp(2.4rem, 7vw, 5.5rem)/1.02 var(--serif); letter-spacing: -0.02em; text-wrap: balance; }
  .hero__intro { margin-top: 1.25rem; max-width: 32rem; color: #c3c8d2; font-size: 1.125rem; }
  .hero__latest { display: block; margin-top: 2rem; max-width: 28rem; padding: 1rem 0 0; border-top: 1px solid rgba(240, 162, 75, 0.5); text-decoration: none; font: 400 1.25rem/1.3 var(--serif); }
  .hero__latest span { display: block; margin-bottom: 0.4rem; font: 0.75rem/1 var(--mono); color: var(--muted); }
  .hero__latest:hover { color: var(--ember); }

  /* Krønike */
  .chron { padding: 5rem 0 2rem; }
  .chron__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 2rem; }
  .chron__head h2 { font: 2.25rem/1 var(--display); letter-spacing: 0.08em; text-transform: uppercase; }
  .chron__head p { font: 0.75rem/1.4 var(--mono); color: var(--muted); text-align: right; }
  .year { position: relative; padding-top: 1.5rem; padding-bottom: 2.5rem; }
  .year__n { font: clamp(4.5rem, 20vw, 11rem)/0.8 var(--display); color: transparent; -webkit-text-stroke: 1px #42557a; letter-spacing: 0.02em; margin-bottom: 1rem; }
  .entries { border-top: 1px solid var(--line); }
  .entry__ex { font-size: 1rem; line-height: 1.5; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .entry a { display: grid; align-content: start; gap: 0.5rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .entry__meta { font: 0.75rem/1 var(--mono); color: var(--ember); }
  .entry__title { font: 400 1.5rem/1.2 var(--serif); letter-spacing: -0.01em; text-wrap: balance; transition: color 150ms; }
  .entry a:hover .entry__title { color: var(--ember); }

  /* Lab: lysende punkter */
  .lab { padding-top: 3rem; padding-bottom: 5rem; }
  .beacons { border-top: 1px solid var(--line); }
  .beacon { display: grid; grid-template-columns: 1.5rem 1fr auto; gap: 0.3rem 0.75rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .beacon__dot { width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--muted); align-self: center; }
  .is-lit .beacon__dot { background: var(--ember); border-color: var(--ember); box-shadow: 0 0 0 4px rgba(240, 162, 75, 0.12), 0 0 18px 4px rgba(240, 162, 75, 0.45); }
  .beacon__name { font: 400 1.375rem/1.2 var(--serif); text-decoration: underline; text-decoration-color: var(--ember); text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .beacon__what { grid-column: 2 / -1; color: var(--muted); font-size: 1rem; }
  .beacon__status { grid-row: 1; grid-column: 3; font: 0.75rem/1 var(--mono); color: var(--muted); }

  .foot { display: flex; align-items: center; gap: 1rem; padding-top: 2rem; padding-bottom: 3rem; border-top: 1px solid var(--line); color: var(--muted); font: 0.75rem/1.5 var(--mono); }
  .foot a { color: var(--text); text-decoration-color: var(--ember); }

  @media (min-width: 768px) {
    .mast { padding: 2rem 2.5rem; }
    .mast__nav { gap: 2rem; }
    .mast__nav a { font-size: 0.8125rem; }
    .wrap, .hero__text { padding-inline: 2.5rem; }
    .hero img { object-position: center; }
    .hero__text { padding-bottom: 5rem; }
    .year { display: grid; grid-template-columns: 15rem 1fr; column-gap: 3rem; align-items: start; }
    .year__n { position: sticky; top: 2rem; font-size: 7.5rem; }
    .entries { display: grid; grid-template-columns: 1fr 1fr; column-gap: 3rem; border-top: 0; }
    .entry a { height: 100%; padding: 1.6rem 0; border-top: 1px solid var(--line); border-bottom: 0; }
    .entry__title { font-size: 1.75rem; }
    .beacon { grid-template-columns: 1.5rem 14rem 1fr 7rem; }
    .beacon__what { grid-column: 3; }
    .beacon__status { grid-column: 4; text-align: right; }
    .lab .chron__head--lab { display: grid; grid-template-columns: 15rem 1fr; column-gap: 3rem; }
    .lab .chron__head--lab p { text-align: left; }
  }
</style>
