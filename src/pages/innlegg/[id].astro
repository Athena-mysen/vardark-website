---
import EssayView from '../../views/Essay.astro';
import { essays } from '../../lib/essays';

export async function getStaticPaths() {
  const list = await essays('nb');
  return list.map((e, i) => ({ params: { id: e.id }, props: { e, next: list[i - 1], prev: list[i + 1] } }));
}
---
<EssayView lang="nb" {...Astro.props} />
