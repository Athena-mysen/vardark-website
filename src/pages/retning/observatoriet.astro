---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource/fjalla-one/latin.css';
import Retning from '../../layouts/Retning.astro';
import Cairn from '../../components/Cairn.astro';
import { essays, fmtDate, iso } from '../../lib/essays';
import { projects } from '../../data/lab';

const list = await essays();
const links = [
  { href: '/', label: 'Essays' },
  { href: '/lab/', label: 'Lab' },
  { href: '/om/', label: 'Om' },
  { href: '/rss.xml', label: 'RSS' },
];

// Stjernekart: tid langs x. 2022–2025 komprimeres til venstre del, 2026 får resten.
const t = (d: Date) => d.valueOf();
const T0 = t(new Date('2022-05-01')), T1 = t(new Date('2026-01-01')), T2 = t(new Date('2026-10-20'));
const W = 1200, H = 520, BREAK = 0.2;
const x = (d: Date) => 60 + (W - 360) * (t(d) < T1 ? ((t(d) - T0) / (T1 - T0)) * BREAK : BREAK + ((t(d) - T1) / (T2 - T1)) * (1 - BREAK));
const hash = (s: string) => [...s].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const stars = [...list].reverse().map((e) => ({
  ...e,
  cx: x(e.date),
  cy: 120 + (hash(e.id) % 1000) / 1000 * 280,
  r: 3 + Math.min(e.words, 900) / 200,
}));
const named = new Set([list[0].id, ...[...list].sort((a, b) => b.words - a.words).slice(0, 2).map((e) => e.id)]);
const nowX = W - 300;
const lab = projects.map((p, i) => ({ ...p, cx: nowX + 50 + (i % 2) * 60, cy: 130 + i * 84 }));
const months = ['jan', 'feb', 'mar', 'apr', 'mai', 'jun', 'jul', 'aug', 'sep', 'okt'];
const years = [...new Set(list.map((e) => e.date.getFullYear()))];
---
<Retning title="Observatoriet · Vardark designrunde 2" bodyClass="obs">
  <header class="mast wrap">
    <a href="/" class="mast__logo" aria-label="Vardark, til forsiden"><Cairn size={28} /><span>VARDARK</span></a>
    <nav class="mast__nav" aria-label="Hovednavigasjon">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  </header>

  <main id="innhold">
    <div class="sky">
    <section class="hero wrap">
      <p class="label">Observatoriet · Kristian Høegh Mysen</p>
      <h1 class="hero__title">Det som skjer når intelligens blir billig, observert over tid.</h1>
      <p class="hero__intro">Hvert essay er en observasjon. Prototypene i laben er instrumentene. Kartet under viser alt jeg har skrevet, plassert der det hører hjemme i tid.</p>
    </section>

    <figure class="chart wrap">
      <div class="chart__scroll">
      <svg class="chart__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-t">
        <title id="chart-t">Stjernekart: {list.length} essays fra 2022 til 2026 langs en tidsakse, og fire lab-prosjekter som lysende punkter ved nå</title>
        <g class="grid">
          {[0, 1, 2, 3, 4].map((i) => <path d={`M40 ${80 + i * 90} H${W - 20}`} />)}
          {months.map((m, i) => <path d={`M${x(new Date(2026, i, 1))} 60 V${H - 70}`} />)}
        </g>
        <path class="axis" d={`M40 ${H - 50} H${nowX}`} />
        <path class="axis axis--break" d={`M${60 + (W - 360) * BREAK - 6} ${H - 58} l6 16 M${60 + (W - 360) * BREAK} ${H - 58} l6 16`} />
        <text class="tick tick--year" x={x(new Date('2022-06-30'))} y={H - 22}>2022</text>
        <text class="tick tick--year" x={x(new Date('2024-04-06'))} y={H - 22}>2024</text>
        {months.map((m, i) => <text class="tick" x={x(new Date(2026, i, 1))} y={H - 22}>{m}</text>)}
        <text class="tick tick--year" x={x(new Date(2026, 0, 1))} y={H - 4}>2026</text>
        <path class="now" d={`M${nowX} 60 V${H - 50}`} />
        <text class="tick tick--now" x={nowX + 8} y="74">nå</text>
        <polyline class="path" points={stars.map((s) => `${s.cx.toFixed(1)},${s.cy.toFixed(1)}`).join(' ')} />
        {stars.map((s) => (
          <a href={`/essays/${s.id}/`}>
            <title>{s.title} · {fmtDate(s.date)} {s.date.getFullYear()}</title>
            <circle class="halo" cx={s.cx} cy={s.cy} r={s.r * 3.2} />
            <circle class="star" cx={s.cx} cy={s.cy} r={s.r} />
            {named.has(s.id) && (s.cx > 560
              ? <text class="name" x={s.cx - s.r - 8} y={s.cy + 4} text-anchor="end">{s.title}</text>
              : <text class="name" x={s.cx + s.r + 8} y={s.cy + 4}>{s.title}</text>)}
          </a>
        ))}
        {lab.map((p, i) => (
          <a href={p.href}>
            <title>{p.name}: {p.what}</title>
            {i > 0 && <path class="lab-link" d={`M${lab[i - 1].cx} ${lab[i - 1].cy} L${p.cx} ${p.cy}`} />}
            <circle class="lab-glow" cx={p.cx} cy={p.cy} r="22" />
            <circle class={`lab-star ${p.status === 'i drift' ? 'is-lit' : ''}`} cx={p.cx} cy={p.cy} r="5" />
            <circle class="lab-ring" cx={p.cx} cy={p.cy} r="11" />
            <text class="lab-name" x={p.cx + 20} y={p.cy - 2}>{p.name}</text>
            <text class="lab-status" x={p.cx + 20} y={p.cy + 14}>{p.status}</text>
          </a>
        ))}
      </svg>
      </div>
      <figcaption><span><i class="key key--star"></i>Essay, størrelse etter lengde</span><span><i class="key key--lab"></i>Lab-prosjekt</span><span><i class="key key--line"></i>Tidslinjen</span></figcaption>
    </figure>
    </div>

    <section class="log wrap" aria-labelledby="logg">
      <header class="log__head">
        <h2 id="logg" class="label">Observasjonslogg</h2>
        <a class="log__ext" href="https://singularity.vardark.no/tracker">Singularity Observatory →</a>
      </header>
      {years.map((y) => (
        <div class="yr">
          <h3 class="yr__n">{y}</h3>
          <ol class="obsl">
            {list.filter((e) => e.date.getFullYear() === y).map((e) => (
              <li>
                <time datetime={iso(e.date)}>{fmtDate(e.date)}</time>
                <a href={`/essays/${e.id}/`}>{e.title}</a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </section>

    <section class="instr wrap" aria-labelledby="lab">
      <h2 id="lab" class="label">Instrumentene · lab</h2>
      <ul class="instr__grid">
        {projects.map((p) => (
          <li class={p.status === 'i drift' ? 'is-lit' : ''}>
            <span class="instr__dot" aria-hidden="true"></span>
            <a href={p.href}>{p.name}</a>
            <p>{p.what}</p>
            <span class="instr__status">{p.status}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="foot wrap">
    <p>© 2026 Kristian Høegh Mysen · <a href="/rss.xml">RSS</a> · Selskapet: <a href="https://athenatech.no">athenatech.no</a></p>
  </footer>
</Retning>

<style is:global>
  body.obs {
    --bg: #05070d; --text: #e6e3dc; --muted: #9aa3b2; --line: rgba(154, 163, 178, 0.18); --ember: #f0a24b; --star: #dfe6f2;
    --serif: 'Source Serif 4 Variable', Georgia, serif;
    --display: 'Fjalla One', 'Arial Narrow', sans-serif;
    --mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    background: var(--bg) url('/material/stjernefelt.webp') center top / max(100%, 1600px) auto no-repeat;
    color: var(--text); font: 1.1875rem/1.6 var(--serif); color-scheme: dark;
  }
</style>

<style>
  .wrap { width: 100%; max-width: 80rem; margin: 0 auto; padding-inline: 1.25rem; }
  a:focus-visible { outline: 2px solid var(--ember); outline-offset: 4px; }
  .label { font: 500 0.75rem/1 var(--mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ember); }

  .mast { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.5rem; padding-bottom: 1.5rem; }
  .mast__logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; }
  .mast__logo span { font: 1.25rem/1 var(--display); letter-spacing: 0.22em; padding-top: 3px; }
  .mast__nav { display: flex; gap: 1.1rem; }
  .mast__nav a { font: 0.75rem/1 var(--mono); color: var(--muted); text-decoration: none; }
  .mast__nav a:first-child { color: var(--text); border-bottom: 1px solid var(--ember); padding-bottom: 3px; }

  .sky { padding-bottom: 2rem; }
  .hero { padding-top: 3rem; padding-bottom: 2rem; }
  .hero__title { margin-top: 1.25rem; max-width: 17ch; font: 300 clamp(2.4rem, 7vw, 5.25rem)/1.03 var(--serif); letter-spacing: -0.02em; text-wrap: balance; }
  .hero__intro { margin-top: 1.5rem; max-width: 34rem; color: #c3c8d2; }

  /* Stjernekartet */
  .chart { margin-top: 1.5rem; }
  /* rtl gjør at mobil åpner kartet ved «nå»; svg-en selv er ltr */
  .chart__scroll { overflow-x: auto; direction: rtl; }
  .chart__svg { direction: ltr; }
  .chart__svg { width: 100%; min-width: 46rem; height: auto; }
  .grid path { stroke: rgba(154, 163, 178, 0.09); stroke-width: 1; }
  .axis { stroke: rgba(230, 227, 220, 0.5); stroke-width: 1; fill: none; }
  .tick { font: 11px var(--mono); fill: var(--muted); text-anchor: middle; }
  .tick--year { fill: var(--text); }
  .tick--now { fill: var(--ember); text-anchor: start; }
  .now { stroke: var(--ember); stroke-width: 1; stroke-dasharray: 2 4; }
  .path { fill: none; stroke: rgba(223, 230, 242, 0.28); stroke-width: 1; }
  .halo { fill: rgba(223, 230, 242, 0.07); }
  .star { fill: var(--star); filter: drop-shadow(0 0 4px rgba(223, 230, 242, 0.8)); }
  a:hover .star { fill: var(--ember); }
  .name { font: italic 15px var(--serif); fill: var(--text); }
  .lab-link { stroke: rgba(240, 162, 75, 0.35); stroke-width: 1; }
  .lab-glow { fill: rgba(240, 162, 75, 0.12); }
  .lab-star { fill: #6b4a24; }
  .lab-star.is-lit { fill: var(--ember); }
  .lab-ring { fill: none; stroke: rgba(240, 162, 75, 0.55); stroke-width: 1; }
  .lab-name { font: 15px var(--serif); fill: var(--text); }
  .lab-status { font: 10px var(--mono); fill: var(--ember); letter-spacing: 0.06em; }
  .chart figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.5rem; margin-top: 0.75rem; font: 0.75rem/1.4 var(--mono); color: var(--muted); }
  .key { display: inline-block; vertical-align: middle; margin-right: 0.4rem; }
  .key--star { width: 7px; height: 7px; border-radius: 50%; background: var(--star); }
  .key--lab { width: 9px; height: 9px; border-radius: 50%; background: var(--ember); box-shadow: 0 0 10px 2px rgba(240, 162, 75, 0.5); }
  .key--line { width: 1.5rem; border-top: 1px solid rgba(223, 230, 242, 0.5); }

  /* Logg: vertikal tidslinje */
  .log { padding-top: 5rem; padding-bottom: 3rem; }
  .log__head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .log__ext { font: 0.75rem/1 var(--mono); color: var(--text); text-decoration-color: var(--ember); }
  .yr { display: grid; gap: 0.5rem; padding-top: 2rem; }
  .yr__n { font: 2.25rem/1 var(--display); letter-spacing: 0.06em; color: var(--text); }
  .obsl { position: relative; padding-left: 1.75rem; }
  .obsl::before { content: ''; position: absolute; left: 0.3rem; top: 0.6rem; bottom: 0.6rem; border-left: 1px solid rgba(223, 230, 242, 0.25); }
  .obsl li { position: relative; display: grid; gap: 0.15rem; padding: 0.7rem 0; }
  .obsl li::before { content: ''; position: absolute; left: -1.62rem; top: 1.15rem; width: 7px; height: 7px; border-radius: 50%; background: var(--star); box-shadow: 0 0 8px 1px rgba(223, 230, 242, 0.5); }
  .obsl time { font: 0.75rem/1 var(--mono); color: var(--muted); }
  .obsl a { font: 400 1.3125rem/1.3 var(--serif); text-decoration: none; }
  .obsl a:hover { color: var(--ember); }

  .instr { padding-top: 3rem; padding-bottom: 5rem; }
  .instr__grid { display: grid; gap: 1px; margin-top: 1.25rem; background: var(--line); border: 1px solid var(--line); }
  .instr__grid li { display: grid; gap: 0.5rem; align-content: start; padding: 1.5rem; background: rgba(5, 7, 13, 0.82); }
  .instr__dot { width: 10px; height: 10px; border-radius: 50%; border: 1px solid var(--ember); }
  .is-lit .instr__dot { background: var(--ember); box-shadow: 0 0 0 5px rgba(240, 162, 75, 0.12), 0 0 22px 6px rgba(240, 162, 75, 0.45); }
  .instr__grid a { font: 400 1.5rem/1.2 var(--serif); text-decoration: underline; text-decoration-color: var(--ember); text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .instr__grid p { font-size: 1rem; color: var(--muted); }
  .instr__status { font: 0.6875rem/1 var(--mono); color: var(--ember); text-transform: uppercase; letter-spacing: 0.08em; }

  .foot { padding-top: 2rem; padding-bottom: 3rem; border-top: 1px solid var(--line); font: 0.75rem/1.5 var(--mono); color: var(--muted); }
  .foot a { color: var(--text); text-decoration-color: var(--ember); }

  @media (min-width: 768px) {
    .wrap { padding-inline: 2.5rem; }
    .mast__nav { gap: 2rem; }
    .mast__nav a { font-size: 0.8125rem; }
    .hero { padding-top: 5rem; display: grid; grid-template-columns: 1.4fr 1fr; column-gap: 4rem; align-items: end; }
    .hero .label { grid-column: 1 / -1; }
    .hero__intro { margin-top: 0; padding-bottom: 0.6rem; }
    .chart__svg { min-width: 0; }
    .yr { grid-template-columns: 12rem 1fr; column-gap: 3rem; padding-top: 2.5rem; }
    .yr__n { font-size: 3rem; position: sticky; top: 2rem; align-self: start; }
    .obsl li { grid-template-columns: 6rem 1fr; column-gap: 1.5rem; align-items: baseline; }
    .instr__grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
