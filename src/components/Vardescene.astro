---
// Nattlandskapet med vardekjeden. Ett statisk SVG-lag (himmel, fjell, varder) som aldri tegnes på nytt,
// og lette lag over for alt som beveger seg (nordlys, tåke, glød, flammer, gnister, signal, krusninger).
// Animasjon bare med transform/opacity, så nettleseren kan gjøre det på GPU-en. Posisjoner: /scene.css.
import { W, H, f, layers, big, flame, chain, stars, twinkles, signal } from '../lib/scene';

const clip = big.stones.map((s) => s.d).join(' ');
const tongues = [
  { c: 't1', g: 'fo', d: 'M0 -84 C12 -62 24 -46 24 -28 C24 -10 13 0 0 0 C-13 0 -24 -10 -24 -28 C-24 -44 -14 -56 -8 -64 C-7 -54 -3 -50 0 -48 C3 -58 -1 -72 0 -84Z' },
  { c: 't2', g: 'fm', d: 'M-6 -70 C3 -54 15 -40 15 -24 C15 -9 8 0 -2 0 C-12 0 -17 -9 -17 -22 C-17 -36 -10 -48 -6 -70Z' },
  { c: 't3', g: 'fm', d: 'M9 -58 C14 -44 19 -34 19 -22 C19 -8 13 0 6 0 C-1 0 -4 -8 -4 -18 C-4 -32 3 -42 9 -58Z' },
  { c: 't4', g: 'fi', d: 'M0 -52 C7 -38 12 -28 12 -18 C12 -7 7 0 0 0 C-7 0 -12 -7 -12 -18 C-12 -28 -7 -38 0 -52Z' },
  { c: 't5', g: 'fc', d: 'M0 -30 C4 -22 7 -16 7 -10 C7 -4 4 0 0 0 C-4 0 -7 -4 -7 -10 C-7 -16 -4 -22 0 -30Z' },
];
---
<div class="scene" aria-hidden="true">
  <svg class="layer" viewBox={`0 0 ${W} ${H}`}>
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#02040a" /><stop offset="0.55" stop-color="#0a1426" /><stop offset="0.78" stop-color="#16253f" /><stop offset="1" stop-color="#0c1424" />
      </linearGradient>
      <radialGradient id="spill"><stop offset="0" stop-color="#f0a24b" stop-opacity="0.18" /><stop offset="1" stop-color="#f0a24b" stop-opacity="0" /></radialGradient>
      <radialGradient id="rim" gradientUnits="userSpaceOnUse" cx={flame.x} cy={f(flame.y)} r="430"><stop offset="0" stop-color="#ffc47a" stop-opacity="0.9" /><stop offset="0.45" stop-color="#f0a24b" stop-opacity="0.35" /><stop offset="1" stop-color="#f0a24b" stop-opacity="0" /></radialGradient>
      <linearGradient id="g0" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a3029" /><stop offset="0.3" stop-color="#1c1a1c" /><stop offset="1" stop-color="#09090c" /></linearGradient>
      <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f2c2c" /><stop offset="0.35" stop-color="#16171b" /><stop offset="1" stop-color="#08090c" /></linearGradient>
      <linearGradient id="g2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#443428" /><stop offset="0.28" stop-color="#211d1c" /><stop offset="1" stop-color="#0b0b0e" /></linearGradient>
      <linearGradient id="moon" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#9fb8e8" stop-opacity="0.16" /><stop offset="0.3" stop-color="#9fb8e8" stop-opacity="0" /><stop offset="0.7" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity="0.45" /></linearGradient>
      <radialGradient id="warm" gradientUnits="userSpaceOnUse" cx={flame.x} cy={f(flame.y)} r="95"><stop offset="0" stop-color="#ff9d42" stop-opacity="0.42" /><stop offset="1" stop-color="#ff9d42" stop-opacity="0" /></radialGradient>
      <linearGradient id="log" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5a3520" /><stop offset="1" stop-color="#140a05" /></linearGradient>
      <linearGradient id="fogg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a3d5e" stop-opacity="0" /><stop offset="0.5" stop-color="#2a3d5e" stop-opacity="0.3" /><stop offset="1" stop-color="#2a3d5e" stop-opacity="0" /></linearGradient>
      <linearGradient id="water" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0b1424" /><stop offset="1" stop-color="#03060c" /></linearGradient>
      <linearGradient id="gate" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0a24b" stop-opacity="0.45" /><stop offset="1" stop-color="#f0a24b" stop-opacity="0" /></linearGradient>
      <filter id="blur-l" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="40" /></filter>
      <filter id="blur-m" x="-50%" width="200%"><feGaussianBlur stdDeviation="9 4" /></filter>
      <clipPath id="cairn-clip"><path d={clip} /></clipPath>
    </defs>

    <rect width={W} height={H} fill="url(#sky)" />
    <ellipse cx="760" cy="300" rx="900" ry="120" transform="rotate(12 760 300)" fill="#c8d4ff" opacity="0.05" filter="url(#blur-l)" />
    <g fill="#e9eefc">{stars.map((s) => <circle cx={f(s.x)} cy={f(s.y)} r={s.r.toFixed(2)} opacity={s.o.toFixed(2)} />)}</g>

    {layers.map((L, i) => (
      <>
        <path d={L.r.d} fill={L.fill} />
        {i >= 2 && <path d={L.r.line} fill="none" stroke="url(#rim)" stroke-width={i === 3 ? 1.6 : 1} />}
        {i < 3 && <rect x="-40" y={f(L.r.at(800) - 20)} width={W + 80} height="110" fill="url(#fogg)" />}
        {chain.filter((c) => c.l === i).map((c) => (
          <g>
            {c.cairn.stones.map((st) => <path d={st.d} fill={`url(#g${st.g})`} stroke="#05060a" stroke-width="0.5" />)}
            {c.cairn.stones.map((st) => <path d={st.edge} stroke="#ffb35c" stroke-opacity={(st.o * 0.8).toFixed(2)} stroke-width="0.7" stroke-linecap="round" fill="none" />)}
            {c.cairn.logs.map((l) => <rect x={f(l.x)} y={f(l.y)} width={f(l.w)} height={f(l.h)} rx={f(l.h / 2)} fill="url(#log)" transform={`rotate(${l.a} ${f(l.x)} ${f(l.y + l.h / 2)})`} />)}
          </g>
        ))}
      </>
    ))}

    <ellipse cx={flame.x} cy={f(flame.y + 150)} rx="380" ry="230" fill="url(#spill)" />
    <g>
      {big.stones.map((st) => <path d={st.d} fill={`url(#g${st.g})`} stroke="#050608" stroke-width="0.9" />)}
      <g clip-path="url(#cairn-clip)">
        <rect x={flame.x - 60} y={f(flame.y - 10)} width="120" height="220" fill="url(#moon)" />
        <rect x={flame.x - 160} y={f(flame.y - 40)} width="320" height="260" fill="url(#warm)" />
      </g>
      {big.stones.map((st) => <path d={st.edge} stroke="#ffbb6b" stroke-opacity={st.o.toFixed(2)} stroke-width="1.5" stroke-linecap="round" fill="none" />)}
      {big.logs.map((l) => <rect x={f(l.x)} y={f(l.y)} width={f(l.w)} height={f(l.h)} rx={f(l.h / 2)} fill="url(#log)" stroke="#060302" stroke-width="0.6" transform={`rotate(${l.a} ${f(l.x)} ${f(l.y + l.h / 2)})`} />)}
    </g>

    <rect x="-40" y="905" width={W + 80} height="100" fill="url(#water)" />
    <path d={`M-40 905.5 L${W + 40} 905.5`} stroke="#1c2a44" stroke-width="1" />
    <path d={`M${flame.x - 24} 906 L${flame.x + 24} 906 L${flame.x + 72} 1000 L${flame.x - 72} 1000Z`} fill="url(#gate)" filter="url(#blur-m)" />
  </svg>

  <div class="aurora"><i></i><i></i><i></i></div>
  <svg class="layer twinkle" viewBox={`0 0 ${W} ${H}`}>
    {twinkles.map((s) => <circle cx={f(s.x)} cy={f(s.y)} r={s.r.toFixed(2)} fill="#f4f7ff" class={`tw tw${s.c}`} />)}
  </svg>
  <div class="fog"><i></i><i></i></div>

  {[0, 1, 2].map((k) => (
    <svg class={`layer signal sig${k + 1}`} viewBox={`0 0 ${W} ${H}`}>
      {signal.map((d) => <path d={d} fill="none" stroke="#f0a24b" stroke-width="1.3" stroke-dasharray="2 10" stroke-dashoffset={-k * 4} stroke-linecap="round" />)}
    </svg>
  ))}

  <div class="glow"></div>
  <svg class="defs" width="0" height="0">
    <defs>
      <linearGradient id="fo" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#e5541c" /><stop offset="0.6" stop-color="#c8401a" stop-opacity="0.85" /><stop offset="1" stop-color="#8f2a12" stop-opacity="0" /></linearGradient>
      <linearGradient id="fm" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#ffb04a" /><stop offset="0.7" stop-color="#f27a2a" /><stop offset="1" stop-color="#e5541c" stop-opacity="0.2" /></linearGradient>
      <linearGradient id="fi" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#fff0c2" /><stop offset="0.5" stop-color="#ffd06e" /><stop offset="1" stop-color="#ffa53c" stop-opacity="0.4" /></linearGradient>
      <radialGradient id="fc" cy="0.75"><stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#fff2c8" stop-opacity="0.6" /></radialGradient>
      <radialGradient id="coal"><stop offset="0" stop-color="#ffb35c" stop-opacity="0.9" /><stop offset="1" stop-color="#ff6a1a" stop-opacity="0" /></radialGradient>
    </defs>
  </svg>
  {chain.map((c) => (
    <div class={`fire fire--small b${c.i + 1}`}>
      <svg viewBox="-48 -96 96 96">{tongues.slice(0, 4).map((t) => <path d={t.d} fill={`url(#${t.g})`} class={`tongue ${t.c}`} />)}</svg>
    </div>
  ))}
  <div class="fire fire--main">
    <svg viewBox="-48 -96 96 96">
      <ellipse cx="0" cy="-2" rx="30" ry="9" fill="url(#coal)" class="coal" />
      {tongues.map((t) => <path d={t.d} fill={`url(#${t.g})`} class={`tongue ${t.c}`} />)}
    </svg>
    <i class="spark s1"></i><i class="spark s2"></i><i class="spark s3"></i><i class="spark s4"></i><i class="spark s5"></i><i class="spark s6"></i><i class="spark s7"></i><i class="spark s8"></i>
  </div>
  <div class="ripples"><i></i><i></i><i></i><i></i><i></i><i></i></div>
</div>

<style>
  /* Scenen er alltid 16:10, som viewBox. Forelderen bestemmer bredde og plassering. */
  .scene { position: absolute; aspect-ratio: 16 / 10; overflow: hidden; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .defs { position: absolute; }
  .aurora, .twinkle, .fog, .signal, .glow, .fire, .ripples { will-change: transform; }

  .aurora { position: absolute; inset: 0; mix-blend-mode: screen; }
  .aurora i { position: absolute; left: -15%; width: 130%; border-radius: 50%; filter: blur(28px); background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0 3px, transparent 3px 22px),
      linear-gradient(to bottom, transparent, rgba(95, 214, 176, 0.16) 55%, rgba(138, 240, 200, 0.32) 82%, transparent); }
  .aurora i:nth-child(1) { top: 6%; height: 30%; transform: rotate(-7deg); animation: aur1 46s ease-in-out infinite alternate; }
  .aurora i:nth-child(2) { top: 16%; height: 22%; opacity: 0.7; transform: rotate(4deg); animation: aur2 61s ease-in-out infinite alternate; }
  .aurora i:nth-child(3) { top: 2%; height: 18%; left: 20%; width: 90%; opacity: 0.45; transform: rotate(-12deg); animation: aur3 37s ease-in-out infinite alternate; }
  @keyframes aur1 { to { transform: translate3d(5%, 2%, 0) rotate(-4deg) scaleY(1.15); } }
  @keyframes aur2 { to { transform: translate3d(-6%, -2%, 0) rotate(7deg) scaleY(0.85); opacity: 0.95; } }
  @keyframes aur3 { to { transform: translate3d(8%, 3%, 0) rotate(-9deg); opacity: 0.25; } }

  .tw { animation: tw 5.5s ease-in-out infinite; }
  .tw2 { animation-delay: -1.1s; animation-duration: 7s; } .tw3 { animation-delay: -2.6s; animation-duration: 4.6s; }
  .tw4 { animation-delay: -3.4s; animation-duration: 8s; } .tw5 { animation-delay: -4.2s; animation-duration: 6.2s; }
  @keyframes tw { 0%, 100% { opacity: 0.9; } 50% { opacity: 0.1; } }

  .fog { position: absolute; inset: 0; }
  .fog i { position: absolute; left: -20%; width: 140%; height: 9%; background: linear-gradient(transparent, rgba(54, 76, 112, 0.22), transparent); }
  .fog i:first-child { top: 63%; animation: fog 70s ease-in-out infinite alternate; }
  .fog i:last-child { top: 71%; animation: fog 90s ease-in-out infinite alternate-reverse; }
  @keyframes fog { to { transform: translate3d(9%, 0, 0); } }

  /* Signalet «vandrer»: tre ferdigtegnede lag med forskjøvne prikker tones inn etter tur (bare opacity, GPU) */
  .signal { opacity: 0; animation: sig 1.5s linear infinite; }
  .sig2 { animation-delay: -1s; } .sig3 { animation-delay: -0.5s; }
  @keyframes sig { 0%, 100% { opacity: 0; } 33% { opacity: 0.55; } 66% { opacity: 0; } }

  .glow { position: absolute; left: var(--fx); top: var(--fy); width: 52%; aspect-ratio: 1; translate: -50% -52%; border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 196, 120, 0.34), rgba(240, 162, 75, 0.13) 22%, rgba(240, 162, 75, 0.04) 45%, transparent 65%);
    animation: breathe 6s ease-in-out infinite; }
  @keyframes breathe { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.8; transform: scale(0.96); } }

  .fire { position: absolute; translate: -50% -100%; }
  .fire svg { display: block; width: 100%; overflow: visible; }
  .fire--main { left: var(--fx); top: calc(var(--fy) + 0.3%); width: 6%; }
  .fire--small { width: 2.4%; }
  .fire--small::before { content: ''; position: absolute; inset: -160% -160% -60%; border-radius: 50%; background: radial-gradient(circle at 50% 62%, rgba(255, 180, 100, 0.4), rgba(240, 162, 75, 0.1) 30%, transparent 60%); }
  .b1 { left: var(--c1x); top: var(--c1y); } .b2 { left: var(--c2x); top: var(--c2y); width: 1.8%; }
  .b3 { left: var(--c3x); top: var(--c3y); } .b4 { left: var(--c4x); top: var(--c4y); width: 1.8%; }
  /* Kjeden tennes én etter én, fra den store varden og utover */
  .fire--small { animation: tenn 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .b1 { animation-delay: 1s; } .b2 { animation-delay: 2.2s; } .b3 { animation-delay: 1.5s; } .b4 { animation-delay: 2.8s; }
  @keyframes tenn { from { opacity: 0; transform: scale(0.2); } 60% { opacity: 1; } to { opacity: 1; transform: none; } }

  .tongue { transform-box: fill-box; transform-origin: 50% 100%; animation: lick 2.2s ease-in-out infinite; }
  .t1 { animation-duration: 2.6s; } .t2 { animation-name: lick-l; animation-duration: 1.7s; animation-delay: -0.4s; }
  .t3 { animation-name: lick-r; animation-duration: 1.9s; animation-delay: -1.1s; } .t4 { animation-duration: 1.4s; animation-delay: -0.6s; }
  .t5 { animation-duration: 1.1s; animation-delay: -0.3s; }
  @keyframes lick { 0%, 100% { transform: scale(1, 1) skewX(0deg); } 25% { transform: scale(0.96, 1.07) skewX(2.5deg); } 50% { transform: scale(1.03, 0.95) skewX(-1.5deg); } 75% { transform: scale(0.97, 1.05) skewX(-3deg); } }
  @keyframes lick-l { 0%, 100% { transform: scale(1, 1) skewX(0deg); } 33% { transform: scale(0.9, 1.12) skewX(-6deg); } 66% { transform: scale(1.04, 0.92) skewX(3deg); } }
  @keyframes lick-r { 0%, 100% { transform: scale(1, 1) skewX(0deg); } 40% { transform: scale(0.92, 1.1) skewX(6deg); } 70% { transform: scale(1.05, 0.94) skewX(-2deg); } }
  .coal { animation: coal 3s ease-in-out infinite; }
  @keyframes coal { 50% { opacity: 0.65; } }

  .spark { position: absolute; left: 50%; top: 40%; width: 3px; height: 3px; border-radius: 50%; background: #ffd08a; box-shadow: 0 0 6px 1px rgba(255, 170, 80, 0.8); opacity: 0;
    animation: rise 5.5s cubic-bezier(0.15, 0.6, 0.35, 1) infinite; }
  .s1 { --dx: -40px; } .s2 { --dx: 26px; animation-delay: -0.7s; animation-duration: 6.5s; } .s3 { --dx: -14px; animation-delay: -1.4s; width: 2px; height: 2px; }
  .s4 { --dx: 48px; animation-delay: -2.1s; animation-duration: 7.2s; } .s5 { --dx: -58px; animation-delay: -2.9s; } .s6 { --dx: 12px; animation-delay: -3.6s; animation-duration: 4.8s; width: 2px; height: 2px; }
  .s7 { --dx: 34px; animation-delay: -4.3s; animation-duration: 6.1s; } .s8 { --dx: -24px; animation-delay: -5s; animation-duration: 5s; }
  @keyframes rise { 0% { opacity: 0; transform: translate3d(0, 0, 0) scale(1); } 8% { opacity: 1; } 70% { opacity: 0.6; } 100% { opacity: 0; transform: translate3d(var(--dx), -260px, 0) scale(0.4); } }

  .ripples { position: absolute; left: var(--fx); top: 91%; width: 9%; height: 8%; translate: -50% 0; }
  .ripples i { position: absolute; left: 50%; height: 1.5px; border-radius: 1px; background: linear-gradient(90deg, transparent, rgba(255, 197, 107, 0.75), transparent); translate: -50% 0; animation: rip 3.4s ease-in-out infinite alternate; }
  .ripples i:nth-child(1) { top: 4%; width: 30%; } .ripples i:nth-child(2) { top: 20%; width: 46%; animation-delay: -0.8s; }
  .ripples i:nth-child(3) { top: 37%; width: 38%; animation-delay: -1.6s; opacity: 0.8; } .ripples i:nth-child(4) { top: 54%; width: 64%; animation-delay: -2.2s; opacity: 0.6; }
  .ripples i:nth-child(5) { top: 71%; width: 52%; animation-delay: -0.4s; opacity: 0.45; } .ripples i:nth-child(6) { top: 88%; width: 80%; animation-delay: -2.9s; opacity: 0.3; }
  @keyframes rip { from { transform: translate3d(-8%, 0, 0) scaleX(0.9); } to { transform: translate3d(8%, 0, 0) scaleX(1.1); } }
</style>
