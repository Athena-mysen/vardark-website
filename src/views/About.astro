---
import Layout from '../layouts/Layout.astro';
import { paths, other, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const nb = lang === 'nb';
const site = Astro.site!.href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  inLanguage: nb ? 'nb-NO' : 'en',
  mainEntity: { '@type': 'Person', '@id': `${site}#kristian`, name: 'Kristian Høegh Mysen', alumniOf: 'NTNU', sameAs: ['https://www.linkedin.com/in/kristianmysen'], worksFor: { '@type': 'Organization', name: 'AthenaTech AS', url: 'https://athenatech.no' } },
};
---
<Layout lang={lang} title={nb ? 'Om · Vardark' : 'About · Vardark'} description={nb ? 'Om Kristian Høegh Mysen, vardark.no og navnet Vardark.' : 'About Kristian Høegh Mysen, vardark.no and the name Vardark.'} alt={paths[other(lang)].about} jsonld={jsonld}>
  <div class="about wrap">
    <h1>{nb ? 'Om' : 'About'}</h1>
    {nb ? (
      <div class="prose">
        <p class="lead">Jeg er Kristian Høegh Mysen. Her skriver jeg om frontier-modeller, åpne vekter, sikkerhet og geopolitikk: lange tekster, skrevet for å leses ferdig.</p>
        <p>Jeg er sivilingeniør fra NTNU med over femten år fra forsvarsteknologi og digital transformasjon. Mer enn ti år i Forsvarsmateriell, tolv år i Heimevernet, og de siste årene tilbake ved tastaturet med egne agenter og lokale modeller.</p>
        <p>Essayene ble først skrevet for LinkedIn. Her ligger de samlet, uten algoritme, i den rekkefølgen de ble skrevet. Alle finnes også på engelsk.</p>
      </div>
    ) : (
      <div class="prose">
        <p class="lead">I am Kristian Høegh Mysen. I write about frontier AI models, open weights, security and geopolitics: long pieces, written to be read to the end.</p>
        <p>I hold an MSc in engineering from NTNU and have spent more than fifteen years in defence technology and digital transformation: over ten years at the Norwegian Defence Materiel Agency, twelve in the Home Guard, and lately back at the keyboard with my own agents and local models.</p>
        <p>The essays were first written in Norwegian for LinkedIn. Here they are collected, without an algorithm, in the order they were written, and translated into English.</p>
      </div>
    )}

    <section class="def" aria-labelledby="varde">
      <h2 id="varde" class="def__hw">varde</h2>
      <p class="def__pos">{nb ? 'substantiv, hankjønn' : 'Norwegian, noun: beacon cairn'}</p>
      <p class="def__body">{nb
        ? 'Stabel av stein på en fjelltopp eller et nes, med tørrved klar på toppen. Ifølge Snorre lot Håkon den gode bygge varder langs hele kysten. Når fienden ble sett, ble den første tent, og lyset gikk fra fjell til fjell til hele landet var varslet.'
        : 'A stack of stones on a mountaintop or headland, with dry wood ready on top. According to Snorri, King Haakon the Good had beacons built along the whole Norwegian coast. When an enemy was sighted, the first was lit, and the light passed from mountain to mountain until the whole country had been warned.'}</p>
      <p class="def__note">{nb ? 'Vardark: varden i mørket. Tekstene her er ment som varsellys.' : 'Vardark: the beacon in the dark. The essays here are meant as warning lights.'}</p>
    </section>

    <div class="prose">
      <h2>Lab</h2>
      <p>{nb ? 'Prototyper. De ser ut som prototyper. Det som blir produkt, flytter til AthenaTech.' : 'Prototypes. They look like prototypes. What becomes a product moves to AthenaTech.'} <a href={paths[lang].lab}>{nb ? 'Se laben' : 'See the lab'}</a>.</p>
      <h2>{nb ? 'Selskapet' : 'The company'}</h2>
      <p>{nb ? <><a href="https://athenatech.no">AthenaTech AS</a> er selskapet der KI-agentene gjør arbeidet og menneskene bestemmer retningen. Vardark var prototypen.</> : <><a href="https://athenatech.no">AthenaTech AS</a> is the company where AI agents do the work and people set the direction. Vardark was the prototype.</>}</p>
      <h2>{nb ? 'Kontakt' : 'Contact'}</h2>
      <p><a href="https://www.linkedin.com/in/kristianmysen" rel="me">LinkedIn</a> · <a href={paths[lang].rss}>RSS</a></p>
    </div>
  </div>
</Layout>

<style>
  .about { max-width: 52rem; padding-top: 3rem; }
  h1 { font: clamp(2.5rem, 7vw, 4.5rem)/1 var(--display); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2.5rem; }
  .prose { max-width: 42rem; font-size: 1.1875rem; line-height: 1.7; color: #d9d6cf; }
  .prose > * + * { margin-top: 1.1em; }
  .prose h2 { margin-top: 2.5rem; font: 1.5rem/1 var(--display); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text); }
  .prose a { color: var(--text); text-decoration-color: var(--ember); text-underline-offset: 0.18em; }
  .lead { font-size: 1.5rem; line-height: 1.45; color: var(--text); }
  .def { margin: 4rem 0; padding: 2.5rem 0; border-block: 1px solid var(--line); }
  .def__hw { font: italic 300 clamp(4.5rem, 16vw, 8rem)/0.85 var(--serif); letter-spacing: -0.04em; color: transparent; background: linear-gradient(180deg, #ffd9a0 0%, var(--ember) 45%, #8a4a1c 100%); -webkit-background-clip: text; background-clip: text; filter: drop-shadow(0 0 28px rgba(240, 162, 75, 0.25)); padding-bottom: 0.1em; }
  .def__pos { margin-top: 0.5rem; font: italic 0.95rem/1 var(--serif); color: var(--muted); }
  .def__body { margin-top: 1.5rem; max-width: 38rem; font-size: 1.3rem; line-height: 1.55; color: #cfd3db; }
  .def__note { margin-top: 1rem; font: 0.8125rem/1.5 var(--mono); color: var(--ember); }
</style>
