---
// Én varde med levende bål, tegnet med samme generator som landskapet. Brukes utenfor forsidebildet.
import { cairn, f } from '../lib/scene';
interface Props { id: string; seed?: number; class?: string }
const { id, seed = 7, class: cls } = Astro.props;
const v = cairn(seed, 0, 0, 1, 9);
const g = (n: number) => `url(#${id}-g${n})`;
const tongues = [
  ['fo', 'M0 -84 C12 -62 24 -46 24 -28 C24 -10 13 0 0 0 C-13 0 -24 -10 -24 -28 C-24 -44 -14 -56 -8 -64 C-7 -54 -3 -50 0 -48 C3 -58 -1 -72 0 -84Z'],
  ['fm', 'M-6 -70 C3 -54 15 -40 15 -24 C15 -9 8 0 -2 0 C-12 0 -17 -9 -17 -22 C-17 -36 -10 -48 -6 -70Z'],
  ['fm', 'M9 -58 C14 -44 19 -34 19 -22 C19 -8 13 0 6 0 C-1 0 -4 -8 -4 -18 C-4 -32 3 -42 9 -58Z'],
  ['fi', 'M0 -52 C7 -38 12 -28 12 -18 C12 -7 7 0 0 0 C-7 0 -12 -7 -12 -18 C-12 -28 -7 -38 0 -52Z'],
];
---
<svg class:list={['varde', cls]} viewBox={`-80 ${f(v.top - 100)} 160 ${f(-v.top + 104)}`} aria-hidden="true">
  <defs>
    <radialGradient id={`${id}-halo`}><stop offset="0" stop-color="#ffbf73" stop-opacity="0.45" /><stop offset="0.35" stop-color="#f0a24b" stop-opacity="0.16" /><stop offset="0.7" stop-color="#f0a24b" stop-opacity="0.04" /><stop offset="1" stop-color="#f0a24b" stop-opacity="0" /></radialGradient>
    <linearGradient id={`${id}-g0`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4a3a2d" /><stop offset="0.3" stop-color="#1e1b1c" /><stop offset="1" stop-color="#0a0a0d" /></linearGradient>
    <linearGradient id={`${id}-g1`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a3532" /><stop offset="0.35" stop-color="#17181c" /><stop offset="1" stop-color="#08090c" /></linearGradient>
    <linearGradient id={`${id}-g2`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#55412f" /><stop offset="0.28" stop-color="#231e1c" /><stop offset="1" stop-color="#0b0b0e" /></linearGradient>
    <linearGradient id={`${id}-fo`} x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#e5541c" /><stop offset="0.6" stop-color="#c8401a" stop-opacity="0.85" /><stop offset="1" stop-color="#8f2a12" stop-opacity="0" /></linearGradient>
    <linearGradient id={`${id}-fm`} x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#ffb04a" /><stop offset="0.7" stop-color="#f27a2a" /><stop offset="1" stop-color="#e5541c" stop-opacity="0.2" /></linearGradient>
    <linearGradient id={`${id}-fi`} x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#fff0c2" /><stop offset="0.5" stop-color="#ffd06e" /><stop offset="1" stop-color="#ffa53c" stop-opacity="0.4" /></linearGradient>
    <linearGradient id={`${id}-log`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5a3520" /><stop offset="1" stop-color="#140a05" /></linearGradient>
  </defs>
  <circle cx="0" cy={f(v.top - 20)} r="80" fill={`url(#${id}-halo)`} class="varde__halo" />
  {v.stones.map((st) => <path d={st.d} fill={g(st.g)} stroke="#050608" stroke-width="0.9" />)}
  {v.stones.map((st) => <path d={st.edge} stroke="#ffbb6b" stroke-opacity={st.o.toFixed(2)} stroke-width="1.5" stroke-linecap="round" fill="none" />)}
  {v.logs.map((l) => <rect x={f(l.x)} y={f(l.y)} width={f(l.w)} height={f(l.h)} rx={f(l.h / 2)} fill={`url(#${id}-log)`} transform={`rotate(${l.a} ${f(l.x)} ${f(l.y + l.h / 2)})`} />)}
  <g transform={`translate(0 ${f(v.top + 2)}) scale(0.62)`}>
    {tongues.map(([gr, d], i) => <path d={d} fill={`url(#${id}-${gr})`} class={`vt vt${i + 1}`} />)}
  </g>
</svg>

<style>
  .varde { overflow: visible; }
  .varde__halo { transform-box: fill-box; transform-origin: center; animation: vh 6s ease-in-out infinite; }
  @keyframes vh { 50% { opacity: 0.75; transform: scale(0.95); } }
  .vt { transform-box: fill-box; transform-origin: 50% 100%; animation: vl 2.2s ease-in-out infinite; }
  .vt1 { animation-duration: 2.6s; } .vt2 { animation-duration: 1.7s; animation-delay: -0.4s; } .vt3 { animation-duration: 1.9s; animation-delay: -1.1s; } .vt4 { animation-duration: 1.4s; animation-delay: -0.6s; }
  @keyframes vl { 0%, 100% { transform: scale(1, 1) skewX(0deg); } 25% { transform: scale(0.95, 1.08) skewX(3deg); } 50% { transform: scale(1.03, 0.95) skewX(-2deg); } 75% { transform: scale(0.97, 1.05) skewX(-3deg); } }
</style>
