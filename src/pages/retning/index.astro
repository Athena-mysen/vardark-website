---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import Retning from '../../layouts/Retning.astro';
const dirs = [
  { href: '/retning/nattsiden/', name: 'Nattsiden', what: 'Vardekjeden: levende nattlandskap med nordlys, varder som tennes fra fjell til fjell, essayene som krønike. Utvidet 24.10.' },
  { href: '/retning/nattsiden-forrige/', name: 'Nattsiden (forrige)', what: 'Versjonen fra 21.10, til sammenligning.' },
  { href: '/retning/steinen/', name: 'Steinen', what: 'Lys basalt. Tung kondensert skrift risset i steinen, nummererte essays som en saga.' },
  { href: '/retning/observatoriet/', name: 'Observatoriet', what: 'Stjernekart over alt som er skrevet, lab-prosjektene som lysende punkter. Knytter til Singularity Observatory.' },
];
---
<Retning title="Vardark · designrunde 2" bodyClass="idx">
  <main id="innhold" class="idx__main">
    <p class="idx__k">Vardark · designrunde 2 · tre retninger</p>
    <h1>Velg én retning.</h1>
    <ol>
      {dirs.map((d, i) => (
        <li><a href={d.href}><span>0{i + 1}</span><b>{d.name}</b><i>{d.what}</i></a></li>
      ))}
    </ol>
    <p class="idx__k">Dagens forslag fra runde 1 ligger fortsatt på <a href="/">forsiden</a>.</p>
  </main>
</Retning>
<style is:global>
  body.idx { background: #0f1c2e; color: #f6f6f3; font: 1.125rem/1.5 'Source Serif 4 Variable', Georgia, serif; }
</style>
<style>
  .idx__main { max-width: 52rem; margin: 0 auto; padding: 4rem 1.5rem; }
  .idx__k { font: 0.75rem/1.6 'JetBrains Mono Variable', monospace; color: #9aa3b2; text-transform: uppercase; letter-spacing: 0.08em; }
  .idx__k a { color: #f0a24b; }
  h1 { font-weight: 300; font-size: clamp(2.5rem, 8vw, 4.5rem); line-height: 1; margin: 1rem 0 2.5rem; }
  ol { border-top: 1px solid #22304a; margin-bottom: 2.5rem; }
  li a { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.25rem 1rem; padding: 1.5rem 0; border-bottom: 1px solid #22304a; text-decoration: none; }
  li span { grid-row: span 2; font: 0.8125rem/2.4 'JetBrains Mono Variable', monospace; color: #f0a24b; }
  li b { font-weight: 400; font-size: 2rem; }
  li i { font-style: normal; color: #9aa3b2; }
  li a:hover b { color: #f0a24b; }
  a:focus-visible { outline: 2px solid #f0a24b; outline-offset: 4px; }
</style>
