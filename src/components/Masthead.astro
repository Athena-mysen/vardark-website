---
import Cairn from './Cairn.astro';
import { t, paths, other, type Lang } from '../i18n';
interface Props { lang: Lang; alt?: string; overlay?: boolean }
const { lang, alt, overlay = false } = Astro.props;
const p = paths[lang];
const path = Astro.url.pathname;
const links = [
  { href: p.home, label: t[lang].nav.essays, on: path === p.home || path.includes('/essays/') },
  { href: p.lab, label: t[lang].nav.lab, on: path === p.lab },
  { href: p.about, label: t[lang].nav.about, on: path === p.about },
];
const o = other(lang);
---
<header class:list={['mast', { 'mast--over': overlay }]}>
  <a href={p.home} class="mast__logo" aria-label={t[lang].home}><Cairn size={28} /><span>VARDARK</span></a>
  <nav class="mast__nav" aria-label={t[lang].mainNav}>
    {links.map((l) => <a href={l.href} aria-current={l.on ? 'page' : undefined}>{l.label}</a>)}
    <a href={alt ?? paths[o].home} hreflang={o === 'nb' ? 'nb' : 'en'} lang={o === 'nb' ? 'nb' : 'en'} class="mast__lang" title={t[lang].switchTo}>{t[o].short}</a>
  </nav>
</header>

<style>
  .mast { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem; max-width: 76rem; margin: 0 auto; }
  .mast--over { position: absolute; inset: 0 0 auto; max-width: none; }
  .mast__logo { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--text); }
  .mast__logo { flex-shrink: 0; }
  .mast__logo span { font: 1.25rem/1 var(--display); letter-spacing: 0.16em; padding-top: 3px; }
  .mast__nav { display: flex; align-items: center; gap: 0.85rem; }
  .mast__nav a { font: 0.8125rem/1 var(--mono); color: #b3bccb; text-decoration: none; padding-bottom: 3px; border-bottom: 1px solid transparent; }
  .mast__nav a:hover, .mast__nav a[aria-current='page'] { color: var(--text); border-bottom-color: var(--ember); }
  .mast__nav .mast__lang { padding: 0.35rem 0.5rem; border: 1px solid #2c3a56; border-radius: 2px; color: var(--text); }
  .mast__nav .mast__lang:hover { border-color: var(--ember); }
  @media (min-width: 768px) {
    .mast { padding: 2rem 2.5rem; }
    .mast__logo span { font-size: 1.375rem; letter-spacing: 0.22em; }
    .mast__nav { gap: 2rem; }
    .mast__nav a { font-size: 0.9375rem; }
  }
</style>
